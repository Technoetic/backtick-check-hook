{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "export LC_ALL=C; exec /bin/bash \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" --discover check \"${CLAUDE_PLUGIN_ROOT}/scripts/bash_quote_guard.py\"",
            "timeout": 15,
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "export LC_ALL=C; exec /bin/bash \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" --discover check \"${CLAUDE_PLUGIN_ROOT}/scripts/ps_publish_guard.py\"",
            "timeout": 15,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "set +e; export LC_ALL=C; /bin/bash \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" --discover session \"${CLAUDE_PLUGIN_ROOT}/scripts/bash_quote_guard.py\"; rc=$?; [ \"$rc\" -eq 10 ] || echo \"[backtick-check-hook] Check Bash, the launcher and Python 3.11+ (self-test code $rc).\"; exit 0",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
